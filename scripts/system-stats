#!/usr/bin/env bash
set -Eeuo pipefail
cache=/home/kristyan/.cache/dwm-rice; mkdir -p "$cache"
prev="$cache/net.prev"; now=$(date +%s); iface=$(ip route show default 2>/dev/null|awk '{print $5;exit}'); iface=${iface:-none}
read -r rx tx < <(awk -v i="$iface" '$1 ~ "^"i":" {gsub(":","",$1); print $2,$10}' /proc/net/dev 2>/dev/null || echo '0 0')
if [[ -r $prev ]]; then read -r oldnow oldrx oldtx <"$prev"; else oldnow=$now; oldrx=$rx; oldtx=$tx; fi
dt=$((now-oldnow)); ((dt>0))||dt=1; down=$(((rx-oldrx)/dt)); up=$(((tx-oldtx)/dt)); printf '%s %s %s\n' "$now" "$rx" "$tx" >"$prev"
read -r load1 load5 load15 _ </proc/loadavg; read -r _ user nice sys idle _ </proc/stat; total=$((user+nice+sys+idle)); cpu=$((100*(total-idle)/total))
mem_total=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo); mem_avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo); mem_used=$((mem_total-mem_avail)); mem_pct=$((100*mem_used/mem_total))
root=$(df -Pm /|awk 'NR==2{print $3 "/" $2 " MB (" $5 ")"}'); home=$(df -Pm /home|awk 'NR==2{print $1 ":" $3 "/" $2 " MB (" $5 ")"}')
model=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo|head -1); uptime=$(awk '{printf "%dd %02dh %02dm",$1/86400,($1%86400)/3600,($1%3600)/60}' /proc/uptime)
temp=$(sensors -j 2>/dev/null|jq -r '..|objects|to_entries[]?|select(.key|test("_input$"))|.value|numbers' 2>/dev/null|head -1 || true)
jq -n --arg model "$model" --arg load "$load1 $load5 $load15" --arg root "$root" --arg home "$home" --arg iface "$iface" --arg uptime "$uptime" --arg host "$(cat /etc/hostname)" --arg temp "$temp" --argjson cpu "$cpu" --argjson mem "$mem_pct" --argjson memUsed "$mem_used" --argjson memTotal "$mem_total" --argjson down "$down" --argjson up "$up" '{cpu:$cpu,model:$model,load:$load,temp:$temp,memory:$mem,memoryUsed:$memUsed,memoryTotal:$memTotal,root:$root,home:$home,interface:$iface,download:$down,upload:$up,uptime:$uptime,hostname:$host}' >"$cache/stats.json.tmp"
mv "$cache/stats.json.tmp" "$cache/stats.json"
