#!/usr/bin/env bash
set -Eeuo pipefail

readonly home_dir=/home/kristyan
readonly repo_dir="$home_dir/src/dwm"
readonly cache_dir="$home_dir/.cache/dwm-rice"
readonly wal_dir="$home_dir/.cache/wal"
image=${1:?usage: apply-theme IMAGE}

[[ -r "$image" ]] || { printf 'Wallpaper is not readable: %s\n' "$image" >&2; exit 1; }
mkdir -p "$cache_dir"
wal -n -q -i "$image"
[[ -s "$wal_dir/colors.json" ]] || { printf 'Pywal did not produce colors.json\n' >&2; exit 1; }
"$repo_dir/scripts/generate-theme"

xrdb -merge "$cache_dir/colors.Xresources"
pkill -USR1 -x dwm 2>/dev/null || true
pkill -USR1 -x kitty 2>/dev/null || true
touch "$cache_dir/theme.changed"
