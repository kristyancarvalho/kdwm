#!/usr/bin/env bash
set -Eeuo pipefail

script_path=$(readlink -f "${BASH_SOURCE[0]}")
repo_dir="$(cd -- "$(dirname -- "$script_path")/.." && pwd)"
runtime_dir="${KDWM_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/kdwm}"
wallpaper_dir="$runtime_dir/wallpapers"
index="$wallpaper_dir/index.json"
state="$runtime_dir/state/current-wallpaper"

mkdir -p "$wallpaper_dir" "$(dirname "$state")"

refresh() {
  local source endpoint query categories purity sorting top_range atleast ratios
  source=$(jq -c '.providers[] | select(.enabled and .name == "wallhaven")' "$repo_dir/wallpaper/sources.json" | head -n1)
  endpoint=$(jq -r .endpoint <<<"$source")
  query=$(jq -r .query <<<"$source")
  categories=$(jq -r .categories <<<"$source")
  purity=$(jq -r .purity <<<"$source")
  sorting=$(jq -r .sorting <<<"$source")
  top_range=$(jq -r .topRange <<<"$source")
  atleast=$(jq -r .atleast <<<"$source")
  ratios=$(jq -r .ratios <<<"$source")
  curl --fail --silent --show-error --get "$endpoint" --data-urlencode "q=$query" --data "categories=$categories" --data "purity=$purity" --data "sorting=$sorting" --data "topRange=$top_range" --data "atleast=$atleast" --data "ratios=$ratios" | jq '{items:[.data[] | {id,path,short_url,resolution,category,uploader:.uploader.username}]}' >"$index.tmp"
  [[ $(jq '.items | length' "$index.tmp") -gt 0 ]] || { rm -f "$index.tmp"; return 1; }
  mv "$index.tmp" "$index"
}

download() {
  local id=$1 path file
  path=$(jq -r --arg id "$id" '.items[] | select(.id == $id) | .path' "$index")
  file="$wallpaper_dir/$id.${path##*.}"
  [[ -f "$file" ]] || curl --fail --location --progress-bar "$path" -o "$file"
  printf '%s\n' "$file"
}

default_wallpaper() {
  local id path file
  id=$(jq -r '.default.id' "$repo_dir/wallpaper/sources.json")
  path=$(jq -r '.default.path' "$repo_dir/wallpaper/sources.json")
  file="$wallpaper_dir/$id.${path##*.}"
  [[ -f "$file" ]] || curl --fail --location --progress-bar "$path" -o "$file"
  printf '%s\n' "$file"
}

set_wallpaper() {
  local file=$1
  file=$(realpath "$file")
  [[ -f "$file" ]] || return 1
  feh --no-fehbg --bg-fill "$file"
  "$repo_dir/scripts/apply-theme" "$file"
  printf '%s\n' "$file" >"$state.tmp"
  mv "$state.tmp" "$state"
}

select_wallpaper() {
  [[ -s "$index" ]] || refresh
  local choice id
  choice=$(jq -r '.items[] | "\(.id)  \(.resolution)  \(.category)  \(.uploader)"' "$index" | rofi -dmenu -i -p KDWM -theme "$repo_dir/rofi/kdwm.rasi") || return 0
  id=${choice%% *}
  set_wallpaper "$(download "$id")"
}

restore_wallpaper() {
  local current=
  [[ -s "$state" ]] && current=$(<"$state")
  if [[ -n "$current" && -f "$current" ]]; then
    set_wallpaper "$current"
  else
    set_wallpaper "$(default_wallpaper)"
  fi
}

case "${1:-select}" in
  refresh) refresh ;;
  list) [[ -s "$index" ]] || refresh; jq -r '.items[] | "\(.id)\t\(.resolution)\t\(.short_url)"' "$index" ;;
  set) set_wallpaper "${2:?path required}" ;;
  random) [[ -s "$index" ]] || refresh; set_wallpaper "$(download "$(jq -r '.items | map(.id) | .[now | floor % length]' "$index")")" ;;
  default) set_wallpaper "$(default_wallpaper)" ;;
  restore) restore_wallpaper ;;
  current) cat "$state" 2>/dev/null || true ;;
  select) select_wallpaper ;;
  *) exit 2 ;;
esac
