#!/usr/bin/env bash
set -Eeuo pipefail
repo=/home/kristyan/src/dwm
cache=/home/kristyan/.cache/dwm-rice
mkdir -p "$cache"
[[ -f "$cache/current-wallpaper" ]] && feh --no-fehbg --bg-fill "$(cat "$cache/current-wallpaper")" || true
[[ -f "$cache/current-wallpaper" && -f "$cache/theme.json" ]] && "$repo/scripts/apply-theme" "$(cat "$cache/current-wallpaper")" || true
pgrep -x picom >/dev/null || picom --config "$repo/picom/picom.conf" --daemon
quickshell -p "$repo/quickshell" --no-duplicate --daemonize || true
exec /usr/bin/dwm
