#!/usr/bin/env python3
"""Turn Pywal's raw palette into one dark semantic desktop theme."""

import json
import os
import pathlib
import tempfile


HOME = pathlib.Path("/home/kristyan")
WAL_FILE = HOME / ".cache/wal/colors.json"
OUT_DIR = HOME / ".cache/dwm-rice"


def rgb(value):
    value = value.lstrip("#")
    return tuple(int(value[index:index + 2], 16) for index in (0, 2, 4))


def hexc(color):
    return "#" + "".join(f"{max(0, min(255, round(part))):02x}" for part in color)


def mix(first, second, amount):
    return tuple(a * (1 - amount) + b * amount for a, b in zip(rgb(first), rgb(second)))


def luminance(value):
    channels = []
    for part in rgb(value):
        part /= 255
        channels.append(part / 12.92 if part <= 0.04045 else ((part + 0.055) / 1.055) ** 2.4)
    return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2]


def contrast(first, second):
    bright, dark = sorted((luminance(first), luminance(second)), reverse=True)
    return (bright + 0.05) / (dark + 0.05)


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


with WAL_FILE.open(encoding="utf-8") as handle:
    wal = json.load(handle)

raw_background = wal["special"]["background"]
background = hexc(mix(raw_background, "#000000", 0.38))
surface = hexc(mix(background, wal["colors"]["color8"], 0.18))
surface_elevated = hexc(mix(background, wal["colors"]["color8"], 0.30))
foreground = wal["special"]["foreground"]
if contrast(foreground, background) < 7:
    foreground = hexc(mix(foreground, "#ffffff", 0.38))
muted = hexc(mix(background, foreground, 0.62))
accent = wal["colors"]["color4"]
accent_secondary = wal["colors"]["color6"]
accent_tertiary = wal["colors"]["color5"]
border = hexc(mix(background, accent, 0.34))

theme = {
    "background": background,
    "surface": surface,
    "surfaceElevated": surface_elevated,
    "foreground": foreground,
    "mutedForeground": muted,
    "border": border,
    "accent": accent,
    "accentSecondary": accent_secondary,
    "accentTertiary": accent_tertiary,
    "critical": wal["colors"]["color1"],
    "warning": wal["colors"]["color3"],
    "success": wal["colors"]["color2"],
}

atomic_write(OUT_DIR / "theme.json", json.dumps(theme, indent=2) + "\n")

xresources = f"""*background: {background}
*foreground: {foreground}
dwm.normfg: {foreground}
dwm.normbg: {background}
dwm.normborder: {border}
dwm.selfg: {background}
dwm.selbg: {accent}
dwm.selborder: {accent}
"""
atomic_write(OUT_DIR / "colors.Xresources", xresources)

kitty = [
    f"foreground {foreground}",
    f"background {background}",
    f"cursor {accent}",
    f"cursor_text_color {background}",
    f"selection_foreground {foreground}",
    f"selection_background {surface_elevated}",
    f"url_color {accent_secondary}",
    f"active_border_color {accent}",
    f"inactive_border_color {border}",
]
kitty.extend(f"color{index} {wal['colors'][f'color{index}']}" for index in range(16))
atomic_write(OUT_DIR / "kitty-colors.conf", "\n".join(kitty) + "\n")

rofi = f"""* {{
    wal-background: {background}e8;
    wal-surface: {surface}e6;
    wal-surface-elevated: {surface_elevated}f2;
    wal-foreground: {foreground};
    wal-muted: {muted};
    wal-border: {border}99;
    wal-accent: {accent};
    wal-accent-secondary: {accent_secondary};
}}
"""
atomic_write(OUT_DIR / "rofi-colors.rasi", rofi)
