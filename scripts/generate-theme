#!/usr/bin/env python3
import json
import os
import pathlib
import tempfile


HOME = pathlib.Path("/home/kristyan")
WAL_FILE = HOME / ".cache/wal/colors.json"
OUT_DIR = HOME / ".cache/kdwm/theme"


def rgb(value):
    value = value.lstrip("#")
    return tuple(int(value[index:index + 2], 16) for index in (0, 2, 4))


def hexc(color):
    return "#" + "".join(f"{max(0, min(255, round(part))):02x}" for part in color)


def mix(first, second, amount):
    return tuple(a * (1 - amount) + b * amount for a, b in zip(rgb(first), rgb(second)))


def luminance(value):
    channels = []
    for part in rgb(value):
        part /= 255
        channels.append(part / 12.92 if part <= 0.04045 else ((part + 0.055) / 1.055) ** 2.4)
    return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2]


def contrast(first, second):
    bright, dark = sorted((luminance(first), luminance(second)), reverse=True)
    return (bright + 0.05) / (dark + 0.05)


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


if WAL_FILE.exists():
    with WAL_FILE.open(encoding="utf-8") as handle:
        wal = json.load(handle)
else:
    wal = {"special": {"background": "#07110f", "foreground": "#d7e5df"},
           "colors": {f"color{index}": "#4d9b82" for index in range(16)}}

raw_background = wal["special"]["background"]
background = hexc(mix(raw_background, "#000000", 0.60))
foreground = wal["special"]["foreground"]
if contrast(foreground, background) < 7:
    foreground = hexc(mix(foreground, "#ffffff", 0.45))
surface = hexc(mix(background, foreground, 0.07))
surface_elevated = hexc(mix(background, foreground, 0.13))
muted = hexc(mix(background, foreground, 0.52))
accent = hexc(mix(wal["colors"]["color4"], foreground, 0.18))
if contrast(accent, background) < 3:
    accent = hexc(mix(accent, foreground, 0.42))
accent_dim = hexc(mix(accent, background, 0.58))
border = hexc(mix(background, accent, 0.28))
critical = hexc(mix("#c95c65", background, 0.20))
warning = hexc(mix("#c3a46b", background, 0.25))

theme = {
    "background": background,
    "surface": surface,
    "surfaceElevated": surface_elevated,
    "foreground": foreground,
    "mutedForeground": muted,
    "border": border,
    "accent": accent,
    "accentDim": accent_dim,
    "critical": critical,
    "warning": warning,
    "success": accent,
}

atomic_write(OUT_DIR / "theme.json", json.dumps(theme, indent=2) + "\n")

xresources = f"""*background: {background}
*foreground: {foreground}
dwm.normfg: {foreground}
dwm.normbg: {background}
dwm.normborder: {border}
dwm.selfg: {background}
dwm.selbg: {accent}
dwm.selborder: {accent}
"""
atomic_write(OUT_DIR / "colors.Xresources", xresources)

kitty = [
    f"foreground {foreground}",
    f"background {background}",
    f"cursor {accent}",
    f"cursor_text_color {background}",
    f"selection_foreground {foreground}",
    f"selection_background {surface_elevated}",
    f"url_color {accent}",
    f"active_border_color {accent}",
    f"inactive_border_color {border}",
]
kitty_palette = [background, critical, accent, warning, accent, accent_dim, accent, foreground,
                 muted, critical, accent, warning, accent, accent_dim, accent, foreground]
kitty.extend(f"color{index} {color}" for index, color in enumerate(kitty_palette))
atomic_write(OUT_DIR / "kitty-colors.conf", "\n".join(kitty) + "\n")

rofi = f"""* {{
    kdwm-background: {background}ec;
    kdwm-surface: {surface}e6;
    kdwm-surface-elevated: {surface_elevated}f2;
    kdwm-foreground: {foreground};
    kdwm-muted: {muted};
    kdwm-border: {border}b8;
    kdwm-accent: {accent};
}}
"""
atomic_write(OUT_DIR / "rofi-colors.rasi", rofi)
