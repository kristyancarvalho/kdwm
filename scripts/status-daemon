#!/usr/bin/env bash
set -Eeuo pipefail

previous_total=0
previous_idle=0
script_dir=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)

while true; do
  read -r _ user nice system idle iowait irq softirq steal _ </proc/stat
  total=$((user + nice + system + idle + iowait + irq + softirq + steal))
  idle_total=$((idle + iowait))
  total_delta=$((total - previous_total))
  idle_delta=$((idle_total - previous_idle))
  cpu=0
  (( total_delta > 0 )) && cpu=$(((total_delta - idle_delta) * 100 / total_delta))
  previous_total=$total
  previous_idle=$idle_total
  read -r total_memory available_memory < <(awk '/MemTotal:/ {total=$2} /MemAvailable:/ {available=$2} END {print total, available}' /proc/meminfo)
  memory=$(((total_memory - available_memory) * 100 / total_memory))
  volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{printf "%d%%", $2 * 100; if ($0 ~ /MUTED/) printf "M"}' || true)
  [[ -n "$volume" ]] || volume="--"
  weather=$("$script_dir/weather-status")
  xsetroot -name "CPU $(printf '%02d' "$cpu")%  RAM $(printf '%02d' "$memory")%  VOL ${volume}  ${weather}  $(date '+%H:%M')"
  sleep 2
done
