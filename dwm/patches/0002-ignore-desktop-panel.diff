+int
+isdock(Window w)
+{
+	Atom actual, dock;
+	int format;
+	unsigned long n, extra, i;
+	unsigned char *data = NULL;
+
+	dock = XInternAtom(dpy, "_NET_WM_WINDOW_TYPE_DOCK", False);
+	if (XGetWindowProperty(dpy, w, netatom[NetWMWindowType], 0L, 16L, False,
+		XA_ATOM, &actual, &format, &n, &extra, &data) != Success)
+		return 0;
+	for (i = 0; data && i < n; i++)
+		if (((Atom *)data)[i] == dock) {
+			XFree(data);
+			return 1;
+		}
+	if (data)
+		XFree(data);
+	return 0;
+}
+
 void
 manage(Window w, XWindowAttributes *wa)
 {
+	if (isdock(w)) {
+		XLowerWindow(dpy, w);
+		return;
