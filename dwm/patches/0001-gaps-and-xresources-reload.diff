+static void
+loadxrdb(void)
+{
+	XrmDatabase db;
+	XrmValue value;
+	char *resource_string, *type;
+	struct { const char *name; char *value; } resources[] = {
+		{ "dwm.normfg", normfg }, { "dwm.normbg", normbg },
+		{ "dwm.normborder", normborder }, { "dwm.selfg", selfg },
+		{ "dwm.selbg", selbg }, { "dwm.selborder", selborder },
+	};
+	size_t i;
+
+	XrmInitialize();
+	if (!(resource_string = XResourceManagerString(dpy))
+		|| !(db = XrmGetStringDatabase(resource_string)))
+		return;
+	for (i = 0; i < LENGTH(resources); i++)
+		if (XrmGetResource(db, resources[i].name, "Dwm.Color", &type, &value)
+			&& value.addr && value.size < 8)
+			snprintf(resources[i].value, 8, "%s", value.addr);
+	XrmDestroyDatabase(db);
+}
+
+static void
+reloadtheme(void)
+{
+	Monitor *m;
+	Client *c;
+	size_t i;
+
+	loadxrdb();
+	for (i = 0; i < LENGTH(colors); i++)
+		drw_scm_free(drw, scheme[i], 3);
+	for (i = 0; i < LENGTH(colors); i++)
+		scheme[i] = drw_scm_create(drw, colors[i], 3);
+	for (m = mons; m; m = m->next)
+		for (c = m->clients; c; c = c->next)
+			XSetWindowBorder(dpy, c->win, (m == selmon && c == selmon->sel)
+				? scheme[SchemeSel][ColBorder].pixel : scheme[SchemeNorm][ColBorder].pixel);
+	drawbars();
+}
